# Nusxa oling:  copy .env.example .env   — haqiqiy qiymatlar FAQAT .env da (.env gitga tushmaydi).

# Telegram bot tokeni — BotFather'dan. FAQAT shu yerga qo'yiladi.
# Eski (chatda ochilib qolgan) tokenni ishlatmang: BotFather -> /revoke -> yangi token.
TELEGRAM_BOT_TOKEN=

# Ruxsat etilgan yagona chat_id (Jamshid). Boshqasi rad etiladi.
ALLOWED_CHAT_ID=871134228
# Ixtiyoriy: guruh chat ishlatilsa — faqat shu foydalanuvchi buyruq bera oladi (shaxsiy chatda kerak emas).
ALLOWED_USER_ID=

# Claude: rasmiy Claude Code CLI + Claude Pro/Max obuna (API kalit kerak emas, pullik API ishlatilmaydi).
# Windows xizmati (LocalSystem) uchun: `claude setup-token` chiqargan token. Interaktiv `claude auth login`
# qilingan hisobda ishlasangiz — bo'sh qoldiring. Bu maxfiy qiymat: faqat shu .env da.
CLAUDE_CODE_OAUTH_TOKEN=
# Ixtiyoriy: boshqa claude.exe (bo'sh — claude-agent-sdk bilan kelgan rasmiy CLI)
CLAUDE_CLI_PATH=
# Model shuncha soniya jim tursa (tool ishlamayotganda) — topshiriq to'xtatiladi
CLAUDE_IDLE_TIMEOUT_SEC=900
# Bitta topshiriqning umumiy vaqt chegarasi (soniya, 0 — cheklovsiz)
TASK_TIMEOUT_SEC=7200

# Model. Standart: tez va arzon. Qiyin ishlarga: claude-opus-5-5 (Telegramda /opus <matn>).
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_STRONG_MODEL=claude-opus-5-5
# Fikrlash chuqurligi: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_STRONG_EFFORT=high

# Agent ma'lumotlari papkasi: xotira, skill, skript, jurnal, maxfiy, zaxira, modellar.
# Tavsiya — loyiha ichidagi data papkasi (bitta loyiha). Bo'sh bo'lsa: C:\agent
AGENT_HOME=D:\it-agent\data

# --- Qo'shimcha sozlamalar (standart qiymatlar yetarli) ---
# Veb-qidiruv (WebSearch / WebFetch): 1 yoki 0
WEB_SEARCH=1
# Bitta topshiriqdagi model qadamlari chegarasi (cheksiz aylanmaslik uchun)
MAX_ITERATIONS=60
# Bir vaqtda nechta topshiriq ishlaydi (har biri alohida Claude Code jarayoni; qolganlari navbatda kutadi)
MAX_CONCURRENT_TASKS=3
# Tasdiq so'roviga javob kutish (soniya). Javob bo'lmasa — BAJARILMAYDI.
APPROVAL_TIMEOUT_SEC=900
# Savolga javob kutish (soniya)
QUESTION_TIMEOUT_SEC=1800
# Shuncha soniyadan uzoq ishda progress xabari, keyin har PROGRESS_INTERVAL_SEC da
PROGRESS_AFTER_SEC=60
PROGRESS_INTERVAL_SEC=180
# Bitta buyruq uchun standart timeout (soniya)
COMMAND_TIMEOUT_SEC=600
# pwsh.exe yo'li (bo'sh — avtomatik topiladi)
PWSH_PATH=
# Ishga tushganda Telegramga xabar
NOTIFY_ON_START=1

# Ovozli xabarni matnga aylantirish (lokal faster-whisper, pullik API'siz, ovoz tashqariga chiqmaydi)
STT_ENABLED=1
# Model: AGENT_HOME\modellar ichidagi CTranslate2 whisper papkasi nomi (o'zbekcha uchun univoice-stt-uz-ct2).
STT_MODEL=univoice-stt-uz-ct2
# Til: bo'sh — uz. Avtoaniqlash o'zbekchani ru/en deb o'qigani uchun til qat'iy beriladi.
STT_LANGUAGE=

# --- Proaktiv ishlar (avtomatik topshiriqlarda har qanday o'zgartirish faqat tasdiq bilan) ---
# Zabbix kuzatuvi: inventardagi shu nomli yozuv (url + token, yoki url + username/password). Yozuv bo'lmasa — kutadi.
ZABBIX_ENTRY=zabbix
# Necha soniyada bir ochiq muammolar o'qiladi (0 — o'chiq). So'rash modelsiz — obuna limiti sarflanmaydi.
ZABBIX_POLL_SEC=120
# Qaysi darajadan: 2 Warning, 3 Average, 4 High, 5 Disaster
ZABBIX_MIN_SEVERITY=3
# Soatiga nechta avtomatik tekshiruv (qolganlari faqat xabar bo'lib keladi)
ALERT_TASKS_PER_HOUR=3
# Kunlik tekshiruv vaqti HH:MM (bo'sh — o'chiq). Ro'yxat: AGENT_HOME\xotira\kunlik_tekshiruv.md
DAILY_CHECK_AT=

# --- Instagram Reels studiyasi (1-bosqich: video tayyorlash va Telegram'da tasdiq; joylash hali yo'q) ---
REELS_ENABLED=0
# Kuniga nechta video tayyorlansin (1..10)
REELS_PER_DAY=2
# Har kuni HH:MM da avtomatik tayyorlash (bo'sh — faqat qo'lda: Telegram'da /reels_tayyorla)
REELS_PREPARE_AT=
# Ovoz: auto (Azure kaliti bo'lsa Azure, bo'lmasa edge-tts) | azure | edge
REELS_TTS=auto
# O'zbekcha neyron ovoz: uz-UZ-MadinaNeural (ayol) yoki uz-UZ-SardorNeural (erkak); tezlik masalan +5%
REELS_VOICE=uz-UZ-MadinaNeural
REELS_RATE=+0%
# Ochiq e'lon uchun rasmiy ovoz: Azure AI Speech (bepul tarif: oyiga 500 ming belgi). Maxfiy — faqat shu .env da.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Ixtiyoriy: shrift (o'zbek kirill harflari bilan) va video pastidagi yozuv (masalan @akkaunt)
REELS_FONT=
REELS_BRAND=

# --- Ustki panel (oynacha): ekran tepasidagi boshqaruv oynasi ---
# Agent bilan FAQAT kompyuterning o'zida (127.0.0.1) va token orqali gaplashadi, tashqariga chiqmaydi.
# Oynani ochish: oynacha.cmd   (agent xizmati ishlab turganda).
CONTROL_ENABLED=1
# Mahalliy port (0 — panelni butunlay o'chiradi)
CONTROL_PORT=8787
# Token (bo'sh — har ishga tushganda avtomatik yaratiladi va AGENT_HOME\ish\control.json ga yoziladi)
CONTROL_TOKEN=

# --- Veb-dashboard: SENTINAL CONTROL CENTER (dashboard.cmd) ---
# Faqat 127.0.0.1 va faqat o'qish: buyruq bajarmaydi, boshqa kompyuterlarga ulanmaydi. Agentdan alohida jarayon.
# Mahalliy port
DASHBOARD_PORT=8790
# Kirish tokeni (bo'sh — har ishga tushganda yangisi yaratiladi va AGENT_HOME\ish\dashboard.json ga yoziladi)
DASHBOARD_TOKEN=
# AD eksport CSV fayllari (AGENT_HOME ga nisbatan, ";" bilan). Ustunlar: Name, OS, LastLogon, Disabled, DN (ixtiyoriy)
DASHBOARD_AD_EXPORTS=ish/ActiveComps.csv;ish/StaleComps.csv
# AD da shuncha kundan beri kirilmagan kompyuter "nofaol" (Inactive) hisoblanadi
DASHBOARD_STALE_DAYS=30
# Veb-chat (Claude obunasi orqali, tool'larsiz — faqat javob beradi): 1 yoki 0
DASHBOARD_CHAT=1
# Monitoring o'lchov oralig'i (soniya)
DASHBOARD_SAMPLE_SEC=5

# --- Trading Research (V16): faqat tadqiqot va QOG'OZ savdo (paper trading) ---
# Real savdo, broker/birja buyurtma API'si, broker loginlari — YO'Q. Bozor ma'lumoti: Binance ochiq market-data API.
# Kuniga 10 ta tahlil (NO-TRADE ham tahlil), natija kuzatuvi, SL tahlili, kunlik tadqiqot va hisobot.
# Sozlamalar: AGENT_HOME\trading_memory\config\research_settings.json (instrumentlar, jadval, xarajat modeli).
TRADING_ENABLED=0
# Nashr guruhi: bot guruhga qo'shilgach, Telegram'da /trading_guruh <chat_id> (yoki shu yerda). Bo'sh — nashr yo'q.
TRADING_GROUP_CHAT_ID=
# Ixtiyoriy: forex/metall (XAU/USD, EUR/USD) uchun Twelve Data kaliti (bepul tarif). Maxfiy — faqat shu yerda.
TWELVEDATA_API_KEY=
# V19 MetaTrader 5 (faqat o'qish): bir nechta terminal ochiq bo'lsa — qaysi biri (terminal64.exe to'liq yo'li).
# Login/parol bu yerga YOZILMAYDI: terminalda ochiq turgan DEMO hisob ishlatiladi. Agent terminalni o'zi ishga tushirmaydi.
MT5_PATH=
# REAL hisobdan faqat o'qish uchun ma'lumot olishga ruxsat (default 0 — faqat demo). Buyurtma kodi baribir BLOCK.
MT5_ALLOW_REAL=0
# DEMO savdo chegaralari (V20): lot va bir vaqtdagi ochiq pozitsiyalar
MT5_MAX_LOT=0.10
MT5_MAX_POSITIONS=3
