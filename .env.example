# Nusxa oling:  copy .env.example .env   — haqiqiy qiymatlar FAQAT .env da (.env gitga tushmaydi).

# Telegram bot tokeni — BotFather'dan. FAQAT shu yerga qo'yiladi.
# Eski (chatda ochilib qolgan) tokenni ishlatmang: BotFather -> /revoke -> yangi token.
TELEGRAM_BOT_TOKEN=

# Ruxsat etilgan yagona chat_id (Jamshid). Boshqasi rad etiladi.
ALLOWED_CHAT_ID=871134228
# Ixtiyoriy: guruh chat ishlatilsa — faqat shu foydalanuvchi buyruq bera oladi (shaxsiy chatda kerak emas).
ALLOWED_USER_ID=

# Claude: rasmiy Claude Code CLI + Claude Pro/Max obuna (API kalit kerak emas, pullik API ishlatilmaydi).
# Windows xizmati (LocalSystem) uchun: `claude setup-token` chiqargan token. Interaktiv `claude auth login`
# qilingan hisobda ishlasangiz — bo'sh qoldiring. Bu maxfiy qiymat: faqat shu .env da.
CLAUDE_CODE_OAUTH_TOKEN=
# Ixtiyoriy: boshqa claude.exe (bo'sh — claude-agent-sdk bilan kelgan rasmiy CLI)
CLAUDE_CLI_PATH=
# Model shuncha soniya jim tursa (tool ishlamayotganda) — topshiriq to'xtatiladi
CLAUDE_IDLE_TIMEOUT_SEC=900
# Bitta topshiriqning umumiy vaqt chegarasi (soniya, 0 — cheklovsiz)
TASK_TIMEOUT_SEC=7200

# Model. Standart: tez va arzon. Qiyin ishlarga: claude-opus-5-5 (Telegramda /opus <matn>).
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_STRONG_MODEL=claude-opus-5-5
# Fikrlash chuqurligi: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
ANTHROPIC_STRONG_EFFORT=high

# Agent bazaviy papkasi (ixtiyoriy).
AGENT_HOME=C:\agent

# --- Qo'shimcha sozlamalar (standart qiymatlar yetarli) ---
# Veb-qidiruv (WebSearch / WebFetch): 1 yoki 0
WEB_SEARCH=1
# Bitta topshiriqdagi model qadamlari chegarasi (cheksiz aylanmaslik uchun)
MAX_ITERATIONS=60
# Bir vaqtda nechta topshiriq ishlaydi (har biri alohida Claude Code jarayoni; qolganlari navbatda kutadi)
MAX_CONCURRENT_TASKS=3
# Tasdiq so'roviga javob kutish (soniya). Javob bo'lmasa — BAJARILMAYDI.
APPROVAL_TIMEOUT_SEC=900
# Savolga javob kutish (soniya)
QUESTION_TIMEOUT_SEC=1800
# Shuncha soniyadan uzoq ishda progress xabari, keyin har PROGRESS_INTERVAL_SEC da
PROGRESS_AFTER_SEC=60
PROGRESS_INTERVAL_SEC=180
# Bitta buyruq uchun standart timeout (soniya)
COMMAND_TIMEOUT_SEC=600
# pwsh.exe yo'li (bo'sh — avtomatik topiladi)
PWSH_PATH=
# Ishga tushganda Telegramga xabar
NOTIFY_ON_START=1

# Ovozli xabarni matnga aylantirish (lokal faster-whisper, pullik API'siz, ovoz tashqariga chiqmaydi)
STT_ENABLED=1
# Model: tiny / base / small / medium / large-v3. Kattaroq — aniqroq, lekin sekinroq va kattaroq yuklab olinadi.
# Noutbukda (videokartasiz) small yaxshi muvozanat; o'zbekcha aniqlik past bo'lsa — medium.
STT_MODEL=small
# Til: bo'sh — avtomatik (uz/ru), yoki "uz" / "ru" deb majburlash
STT_LANGUAGE=

# --- Proaktiv ishlar (avtomatik topshiriqlarda har qanday o'zgartirish faqat tasdiq bilan) ---
# Zabbix kuzatuvi: inventardagi shu nomli yozuv (url + token, yoki url + username/password). Yozuv bo'lmasa — kutadi.
ZABBIX_ENTRY=zabbix
# Necha soniyada bir ochiq muammolar o'qiladi (0 — o'chiq). So'rash modelsiz — obuna limiti sarflanmaydi.
ZABBIX_POLL_SEC=120
# Qaysi darajadan: 2 Warning, 3 Average, 4 High, 5 Disaster
ZABBIX_MIN_SEVERITY=3
# Soatiga nechta avtomatik tekshiruv (qolganlari faqat xabar bo'lib keladi)
ALERT_TASKS_PER_HOUR=3
# Kunlik tekshiruv vaqti HH:MM (bo'sh — o'chiq). Ro'yxat: AGENT_HOME\xotira\kunlik_tekshiruv.md
DAILY_CHECK_AT=

# --- Ustki panel (oynacha): ekran tepasidagi boshqaruv oynasi ---
# Agent bilan FAQAT kompyuterning o'zida (127.0.0.1) va token orqali gaplashadi, tashqariga chiqmaydi.
# Oynani ochish: oynacha.cmd   (agent xizmati ishlab turganda).
CONTROL_ENABLED=1
# Mahalliy port (0 — panelni butunlay o'chiradi)
CONTROL_PORT=8787
# Token (bo'sh — har ishga tushganda avtomatik yaratiladi va AGENT_HOME\ish\control.json ga yoziladi)
CONTROL_TOKEN=
